# p2pdesk client 环境配置（复制本文件为 .env 并填写真实值）
# 信令服务器地址
P2PDESK_SERVER=ws://118.31.105.6:9000
# 鉴权 token（必须与服务端一致）
P2PDESK_TOKEN=change-me
# 本机 ID，留空则自动使用 Windows 用户名
P2PDESK_ID=
# 可选：画面帧率 / JPEG 质量 / P2P 打洞超时秒数
P2PDESK_FPS=10
P2PDESK_Q=50
P2PDESK_P2P_TIMEOUT=25
# 可选：P2P 断开后重协商间隔秒数 / 最大重试次数（0=无限重试）
P2PDESK_RENEG_RETRY=5
P2PDESK_RENEG_MAX=0
